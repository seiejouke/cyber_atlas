<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CyberAtlas.exe" product-name="Cyber Atlas" product-version="${version}">
      <authenticode-sign hash-algorithm="sha256" description="Cyber Atlas" description-url="https://github.com/seiejouke/cyber_atlas" />
    </pe-file>
    <pe-file path="uninstaller.exe" product-name="Cyber Atlas" product-version="${version}">
      <authenticode-sign hash-algorithm="sha256" description="Cyber Atlas uninstaller" description-url="https://github.com/seiejouke/cyber_atlas" />
    </pe-file>
    <powershell-file path="update_helper.ps1">
      <authenticode-sign hash-algorithm="sha256" description="Cyber Atlas updater" description-url="https://github.com/seiejouke/cyber_atlas" />
    </powershell-file>
  </zip-file>
</artifact-configuration>
